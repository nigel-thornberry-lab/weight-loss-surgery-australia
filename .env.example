# Google Places API Key
# Get your API key from: https://console.cloud.google.com/
# Required for displaying Google Reviews on surgeon profiles
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Google Sheets Lead Capture Webhook
PUBLIC_GOOGLE_SHEETS_WEBHOOK_URL=your-google-sheets-webhook-url

# Supabase Configuration
# Get these from: https://app.supabase.com/project/_/settings/api
# Required for user authentication and profile claim system
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Stripe Configuration (for Feature 2 - Featured Listings)
# Get these from: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
