---
import BaseLayout from '../layouts/BaseLayout.astro';
import { quizQuestions, calculateRecommendations, type QuizAnswers } from '../data/procedure-quiz-data';
import { procedures } from '../data/calculator-data';

const meta = {
  title: 'Which Weight Loss Surgery Is Right for Me? | Free Procedure Selector Quiz',
  description: 'Take our free 5-minute quiz to find your ideal weight loss surgery. Get personalized recommendations for gastric sleeve, bypass, band & more based on your BMI, health conditions, and goals.',
  keywords: ['weight loss surgery quiz', 'which bariatric surgery is right for me', 'procedure selector', 'gastric sleeve vs bypass quiz']
};

const pageUrl = "https://bariatricsurgeryhub.com/procedure-selector-quiz";

// Schema markup
const schemaMarkup = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Procedure Selector Quiz",
  "description": "Interactive quiz to help determine the best weight loss surgery procedure for your individual situation",
  "applicationCategory": "HealthApplication",
  "operatingSystem": "Any",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "AUD"
  },
  "url": pageUrl
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaMarkup)} />

  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-blue-50 via-purple-50 to-pink-50 py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-3xl md:text-5xl font-bold text-gray-900 mb-4">
        Which Weight Loss Surgery Is Right for Me?
      </h1>
      <p class="text-lg md:text-xl text-gray-600 mb-6">
        Take our free 5-minute quiz to get personalized procedure recommendations based on your BMI, health conditions, goals, and lifestyle.
      </p>
      
      <!-- Trust Signals -->
      <div class="flex flex-wrap justify-center gap-6 text-sm text-gray-600 mb-8">
        <div class="flex items-center">
          <svg class="w-5 h-5 text-green-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          <span class="font-medium">Evidence-Based Recommendations</span>
        </div>
        <div class="flex items-center">
          <svg class="w-5 h-5 text-green-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
          </svg>
          <span class="font-medium">5 Minutes</span>
        </div>
        <div class="flex items-center">
          <svg class="w-5 h-5 text-green-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
          </svg>
          <span class="font-medium">Free, No Obligation</span>
        </div>
      </div>

      <!-- Medical Disclaimer Notice -->
      <div class="bg-amber-50 border-l-4 border-amber-500 rounded-lg p-4 mb-8 max-w-3xl mx-auto">
        <p class="text-sm text-gray-700">
          <strong>Medical Disclaimer:</strong> This quiz is for educational purposes only and is not a replacement for professional medical advice. Only a qualified, AHPRA-registered bariatric surgeon can determine if weight loss surgery is appropriate for you and recommend a specific procedure based on your individual medical assessment.
        </p>
      </div>

      <!-- Quiz Container -->
      <div class="bg-white rounded-2xl shadow-2xl p-6 md:p-10 max-w-3xl mx-auto">
        <!-- Progress Bar -->
        <div class="mb-8">
          <div class="flex justify-between items-center mb-2">
            <span class="text-sm font-medium text-gray-700" id="progress-text">Question 1 of {quizQuestions.length}</span>
            <span class="text-sm font-medium text-gray-700" id="progress-percentage">0%</span>
          </div>
          <div class="w-full bg-gray-200 rounded-full h-2">
            <div class="bg-blue-600 h-2 rounded-full transition-all duration-300" id="progress-bar" style="width: 0%"></div>
          </div>
        </div>

        <!-- Quiz Form -->
        <div id="quiz-form">
          <!-- Questions will be dynamically inserted here -->
        </div>

        <!-- Navigation Buttons -->
        <div class="flex justify-between mt-8">
          <button 
            id="prev-btn" 
            class="px-6 py-3 bg-gray-200 text-gray-700 rounded-lg font-semibold hover:bg-gray-300 transition disabled:opacity-50 disabled:cursor-not-allowed"
            disabled
          >
            ← Previous
          </button>
          <button 
            id="next-btn" 
            class="px-6 py-3 bg-blue-600 text-white rounded-lg font-semibold hover:bg-blue-700 transition disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Next →
          </button>
          <button 
            id="submit-btn" 
            class="hidden px-8 py-3 bg-green-600 text-white rounded-lg font-semibold hover:bg-green-700 transition disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Get My Results
          </button>
        </div>

        <p class="text-xs text-gray-500 text-center mt-6">
          🔒 Your information stays private. No calls, no spam.
        </p>
      </div>
    </div>
  </section>

  <!-- Results Container (Hidden Initially) -->
  <div id="results-container" class="hidden">
    <!-- Results will be dynamically inserted here -->
  </div>

  <!-- Results Template -->
  <template id="results-template">
    <section class="py-16 bg-gradient-to-br from-blue-50 to-green-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Hero: Lead with Recommendation -->
        <div class="text-center mb-12">
          <div class="inline-block px-4 py-2 bg-green-100 rounded-full text-green-800 font-semibold mb-4">
            🎉 Your Results Are Ready!
          </div>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            Your Recommended Procedure
          </h2>
          <p class="text-xl text-gray-600">
            Based on your answers, here's your personalized recommendation:
          </p>
        </div>

        <!-- Primary Recommendation Card -->
        <div class="max-w-4xl mx-auto bg-white rounded-2xl shadow-2xl p-8 md:p-12 mb-8">
          <div class="text-center mb-8">
            <div class="inline-block bg-gradient-to-br from-blue-600 to-purple-600 text-white px-8 py-6 rounded-xl mb-6">
              <p class="text-sm font-medium uppercase tracking-wide mb-2">Primary Recommendation</p>
              <p class="text-4xl md:text-5xl font-bold" id="primary-procedure">Gastric Sleeve</p>
              <p class="text-2xl font-semibold mt-2" id="match-percentage">85% Match</p>
            </div>
            
            <div id="recommendation-reasons" class="text-left space-y-3 mb-8">
              <!-- Reasons will be inserted here -->
            </div>
          </div>

          <!-- Pros & Cons -->
          <div class="grid md:grid-cols-2 gap-6 mb-8">
            <div class="bg-green-50 rounded-xl p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-4 flex items-center">
                <span class="text-2xl mr-2">✅</span>
                Pros for You
              </h3>
              <ul id="pros-list" class="space-y-2 text-gray-700">
                <!-- Pros will be inserted here -->
              </ul>
            </div>
            <div class="bg-amber-50 rounded-xl p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-4 flex items-center">
                <span class="text-2xl mr-2">⚠️</span>
                Considerations
              </h3>
              <ul id="cons-list" class="space-y-2 text-gray-700">
                <!-- Cons will be inserted here -->
              </ul>
            </div>
          </div>

          <!-- Expected Outcomes -->
          <div class="bg-blue-50 rounded-xl p-6 mb-8">
            <h3 class="text-xl font-bold text-gray-900 mb-4">📊 Expected Outcomes</h3>
            <div class="space-y-3 text-gray-700">
              <div>
                <span class="font-semibold">Weight Loss:</span>
                <span id="expected-weight-loss">60-70% excess weight</span>
              </div>
              <div>
                <span class="font-semibold">Timeline:</span>
                <span id="expected-timeline">Most weight loss in first 12-18 months</span>
              </div>
              <div>
                <span class="font-semibold">Health Improvements:</span>
                <ul id="health-improvements" class="list-disc list-inside mt-2 space-y-1">
                  <!-- Health improvements will be inserted here -->
                </ul>
              </div>
            </div>
          </div>

          <!-- Cost Estimate -->
          <div class="bg-purple-50 rounded-xl p-6 mb-8">
            <h3 class="text-xl font-bold text-gray-900 mb-4">💰 Cost Estimate</h3>
            <div class="space-y-2 text-gray-700">
              <div>
                <span class="font-semibold">Total Cost:</span>
                <span id="cost-range">$15,000 - $25,000</span>
              </div>
              <div>
                <span class="font-semibold">With Insurance:</span>
                <span id="cost-insurance">$5,000 - $12,000 out-of-pocket</span>
              </div>
              <a href="/cost-calculator" class="inline-block mt-3 text-blue-600 hover:text-blue-700 font-medium">
                Get Detailed Cost Breakdown →
              </a>
            </div>
          </div>

          <!-- Recovery Timeline -->
          <div class="bg-indigo-50 rounded-xl p-6 mb-8">
            <h3 class="text-xl font-bold text-gray-900 mb-4">⏱️ Recovery Timeline</h3>
            <p class="text-gray-700" id="recovery-timeline">
              <!-- Recovery timeline will be inserted here -->
            </p>
          </div>

          <!-- Next Steps -->
          <div class="bg-yellow-50 border-l-4 border-yellow-500 rounded-lg p-6 mb-8">
            <h3 class="text-xl font-bold text-gray-900 mb-4">📋 Your Next Steps</h3>
            <ol id="next-steps" class="space-y-2 text-gray-700 list-decimal list-inside">
              <!-- Next steps will be inserted here -->
            </ol>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/surgeons" id="find-surgeons-btn" class="bg-green-600 hover:bg-green-700 text-white px-8 py-4 rounded-lg font-bold transition text-center">
              Find Surgeons Near Me
            </a>
            <button id="btn-share-results" class="bg-white hover:bg-gray-50 border-2 border-gray-300 text-gray-700 px-8 py-4 rounded-lg font-semibold transition">
              🔗 Share Results
            </button>
            <button id="btn-save-results" class="bg-white hover:bg-gray-50 border-2 border-gray-300 text-gray-700 px-8 py-4 rounded-lg font-semibold transition">
              📱 Save These Results
            </button>
            <button id="btn-print" class="bg-white hover:bg-gray-50 border-2 border-gray-300 text-gray-700 px-8 py-4 rounded-lg font-semibold transition">
              🖨️ Print This Page
            </button>
          </div>
        </div>

        <!-- Alternative Recommendations -->
        <div class="max-w-4xl mx-auto bg-white rounded-2xl shadow-lg p-8 mb-8">
          <h3 class="text-2xl font-bold text-gray-900 mb-6 text-center">Other Options to Consider</h3>
          <div id="alternative-recommendations" class="space-y-4">
            <!-- Alternative recommendations will be inserted here -->
          </div>
        </div>

        <!-- Email Capture Section -->
        <div class="max-w-4xl mx-auto bg-blue-600 rounded-2xl shadow-2xl p-8 md:p-12 text-white">
          <div class="text-center mb-8">
            <h3 class="text-3xl md:text-4xl font-bold mb-4">
              📥 Get Your Complete Personalized Report
            </h3>
            <p class="text-xl text-blue-100 mb-6">
              Receive a detailed PDF report with your recommendations, cost breakdown, recovery timeline, and next steps.
            </p>
          </div>

          <!-- Email Form -->
          <form id="email-capture-form" class="bg-white/10 backdrop-blur rounded-xl p-6">
            <div class="grid md:grid-cols-2 gap-4 mb-4">
              <div>
                <label class="block text-sm font-medium mb-2">First Name</label>
                <input 
                  type="text" 
                  id="lead-first-name"
                  required
                  class="w-full px-4 py-3 rounded-lg text-gray-900 focus:ring-2 focus:ring-white"
                  placeholder="Your first name"
                />
              </div>
              <div>
                <label class="block text-sm font-medium mb-2">Email Address</label>
                <input 
                  type="email" 
                  id="lead-email"
                  required
                  class="w-full px-4 py-3 rounded-lg text-gray-900 focus:ring-2 focus:ring-white"
                  placeholder="your@email.com"
                />
              </div>
            </div>

            <button type="submit" class="w-full bg-white hover:bg-gray-100 text-blue-600 text-lg font-bold py-4 rounded-lg transition shadow-lg mb-4">
              Send Me My Complete Report
            </button>

            <div class="text-center space-y-2 text-sm text-blue-100">
              <p>🔒 Privacy guaranteed. No spam. Unsubscribe anytime.</p>
              <p>🚫 We never call you. Email-only communication.</p>
            </div>
          </form>

          <div class="mt-6 text-center border-t border-white/20 pt-6">
            <p class="text-blue-100 mb-3">😊 No email? No worries.</p>
            <div class="flex gap-3 justify-center">
              <button id="btn-print-alt" class="text-white hover:text-blue-200 font-medium underline">
                Print This Page
              </button>
              <span class="text-blue-100">or</span>
              <button id="btn-pdf-alt" class="text-white hover:text-blue-200 font-medium underline">
                Save as PDF
              </button>
            </div>
          </div>
        </div>

        <!-- Medical Disclaimer -->
        <div class="max-w-4xl mx-auto bg-gray-100 border-l-4 border-gray-500 rounded-lg p-6 mt-8">
          <h3 class="text-lg font-bold text-gray-900 mb-3">Medical Disclaimer</h3>
          <div class="text-sm text-gray-700 space-y-2">
            <p>
              <strong>This quiz is for educational and informational purposes only and is not a replacement for professional medical advice, diagnosis, or treatment.</strong>
            </p>
            <p>
              The recommendations provided by this tool are based on general guidelines and should not be considered as medical advice. Only a qualified, AHPRA-registered bariatric surgeon can determine if weight loss surgery is appropriate for you and which procedure (if any) is medically suitable based on a comprehensive assessment of your individual health history, current medical condition, BMI, and other relevant factors.
            </p>
            <p>
              Weight loss surgery is a significant medical decision that requires thorough evaluation by a multidisciplinary team including a bariatric surgeon, dietitian, psychologist, and other healthcare professionals. Individual results, outcomes, and suitability vary and must be assessed on a case-by-case basis.
            </p>
            <p>
              Always seek the advice of qualified healthcare providers with any questions you may have regarding a medical condition. Never disregard professional medical advice or delay in seeking it because of information provided by this tool.
            </p>
          </div>
        </div>

      </div>
    </section>
  </template>

  <script>
    import { quizQuestions, calculateRecommendations, type QuizAnswers } from '../data/procedure-quiz-data';
    import { procedures } from '../data/calculator-data';

    // State management
    const state = {
      currentQuestion: 0,
      answers: {} as QuizAnswers,
      recommendations: [] as any[]
    };

    // Initialize
    document.addEventListener('DOMContentLoaded', () => {
      // Load saved progress from localStorage
      const saved = localStorage.getItem('procedure-quiz-progress');
      if (saved) {
        try {
          const savedData = JSON.parse(saved);
          state.currentQuestion = savedData.currentQuestion || 0;
          state.answers = savedData.answers || {};
        } catch (e) {
          console.error('Error loading saved progress:', e);
        }
      }

      setupEventListeners();
      renderQuestion(state.currentQuestion);
      updateProgress();
    });

    function setupEventListeners() {
      // Navigation buttons
      document.getElementById('prev-btn')?.addEventListener('click', () => {
        if (state.currentQuestion > 0) {
          state.currentQuestion--;
          renderQuestion(state.currentQuestion);
          updateProgress();
          saveProgress();
        }
      });

      document.getElementById('next-btn')?.addEventListener('click', () => {
        if (validateCurrentQuestion()) {
          if (state.currentQuestion < quizQuestions.length - 1) {
            state.currentQuestion++;
            renderQuestion(state.currentQuestion);
            updateProgress();
            saveProgress();
          }
        }
      });

      document.getElementById('submit-btn')?.addEventListener('click', () => {
        if (validateCurrentQuestion()) {
          calculateAndShowResults();
        }
      });

      // Action buttons
      document.getElementById('btn-share-results')?.addEventListener('click', async () => {
        const shareData = {
          title: `My Weight Loss Surgery Recommendation: ${state.recommendations[0]?.procedure || 'Procedure Selector Quiz'}`,
          text: `I took the Procedure Selector Quiz and my recommended procedure is ${state.recommendations[0]?.procedure || 'available'}. Check it out!`,
          url: window.location.href
        };

        try {
          if (navigator.share) {
            await navigator.share(shareData);
          } else {
            // Fallback: copy to clipboard
            await navigator.clipboard.writeText(window.location.href);
            alert('Results link copied to clipboard! Share it with anyone.');
          }
        } catch (err) {
          // User cancelled or error - try clipboard fallback
          try {
            await navigator.clipboard.writeText(window.location.href);
            alert('Results link copied to clipboard!');
          } catch (clipboardErr) {
            // Final fallback: show URL
            prompt('Copy this link to share:', window.location.href);
          }
        }
      });

      document.getElementById('btn-save-results')?.addEventListener('click', () => {
        const name = prompt('Enter your name (optional):') || 'Guest';
        const contact = prompt('Your phone or email:');
        if (contact) {
          alert(`Great! We'll send your results to: ${contact}`);
          // Implement actual SMS/email send here
        }
      });

      document.querySelectorAll('[id^="btn-print"]').forEach(btn => {
        btn.addEventListener('click', () => window.print());
      });

      document.getElementById('btn-pdf-alt')?.addEventListener('click', () => {
        window.print(); // Modern browsers save as PDF from print dialog
      });

      // Email form
      document.getElementById('email-capture-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const firstName = (document.getElementById('lead-first-name') as HTMLInputElement).value;
        const email = (document.getElementById('lead-email') as HTMLInputElement).value;

        // Store lead data
        const leadData = {
          firstName,
          email,
          recommendations: state.recommendations,
          answers: state.answers,
          timestamp: new Date().toISOString()
        };

        // Send to backend (webhook or API endpoint)
        const webhookUrl = 'PUBLIC_GOOGLE_SHEETS_WEBHOOK_URL'; // Replace with actual webhook
        
        try {
          await fetch(webhookUrl, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(leadData)
          });

          // Show success message
          const form = document.getElementById('email-capture-form');
          if (form && form.parentElement) {
            form.parentElement.innerHTML = `
              <div class="text-center py-12">
                <div class="inline-block w-20 h-20 bg-green-400 rounded-full flex items-center justify-center mb-6">
                  <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <h3 class="text-3xl font-bold mb-4">Check Your Email!</h3>
                <p class="text-xl text-blue-100 mb-6">
                  We've sent your complete report to <strong>${email}</strong>
                </p>
                <p class="text-blue-100 mb-8">
                  You should receive it within 2 minutes. Check your spam folder if you don't see it.
                </p>
                <a href="/surgeons" class="inline-block bg-white hover:bg-gray-100 text-blue-600 px-8 py-4 rounded-lg font-bold transition">
                  Browse Surgeons Now →
                </a>
              </div>
            `;
          }

        } catch (error) {
          console.error('Error submitting form:', error);
          alert('Something went wrong. Please try again or contact us through our contact form.');
        }
      });
    }

    function renderQuestion(questionIndex: number) {
      const question = quizQuestions[questionIndex];
      const quizForm = document.getElementById('quiz-form');
      if (!quizForm) return;

      let html = `
        <div class="mb-8">
          <div class="mb-6">
            <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-3">
              ${question.question}
            </h2>
            ${question.required ? '' : '<p class="text-sm text-gray-500">(Optional)</p>'}
          </div>
      `;

      // Handle multi-select for health conditions
      if (question.id === 'healthConditions') {
        html += '<div class="space-y-3">';
        question.options.forEach(option => {
          const isChecked = Array.isArray(state.answers.healthConditions) 
            ? state.answers.healthConditions.includes(option.value as string)
            : false;
          html += `
            <label class="flex items-start p-4 bg-white hover:bg-gray-50 border-2 border-gray-300 rounded-lg cursor-pointer transition">
              <input 
                type="checkbox" 
                name="healthConditions" 
                value="${option.value}"
                ${isChecked ? 'checked' : ''}
                class="mt-1 h-5 w-5 text-blue-600 rounded focus:ring-blue-500"
                onchange="window.handleHealthConditionChange('${option.value}')"
              />
              <div class="ml-4 flex-1">
                <span class="font-medium text-gray-900">${option.text}</span>
                ${option.explanation ? `<p class="text-sm text-gray-600 mt-1">${option.explanation}</p>` : ''}
              </div>
            </label>
          `;
        });
        html += '</div>';
      } else {
        // Single select (radio buttons)
        html += '<div class="space-y-3">';
        question.options.forEach(option => {
          const isSelected = state.answers[question.id as keyof QuizAnswers] === option.value;
          html += `
            <label class="flex items-start p-4 bg-white hover:bg-blue-50 border-2 ${isSelected ? 'border-blue-500 bg-blue-50' : 'border-gray-300'} rounded-lg cursor-pointer transition group">
              <input 
                type="radio" 
                name="${question.id}" 
                value="${option.value}"
                ${isSelected ? 'checked' : ''}
                class="mt-1 h-5 w-5 text-blue-600 focus:ring-blue-500"
                onchange="window.handleAnswerChange('${question.id}', '${option.value}')"
              />
              <div class="ml-4 flex-1">
                <span class="font-medium text-gray-900 group-hover:text-gray-900">${option.text}</span>
                ${option.explanation ? `<p class="text-sm text-gray-600 mt-1">${option.explanation}</p>` : ''}
              </div>
            </label>
          `;
        });
        html += '</div>';
      }

      html += '</div>';

      quizForm.innerHTML = html;

      // Update navigation buttons
      updateNavigationButtons();
    }

    // Global handlers for inline event handlers
    (window as any).handleAnswerChange = function(questionId: string, value: string | number) {
      (state.answers as any)[questionId] = value;
      saveProgress();
      updateNavigationButtons();
      renderQuestion(state.currentQuestion); // Re-render to show selection
    };

    (window as any).handleHealthConditionChange = function(value: string) {
      if (!Array.isArray(state.answers.healthConditions)) {
        state.answers.healthConditions = [];
      }
      const index = state.answers.healthConditions.indexOf(value);
      if (index > -1) {
        state.answers.healthConditions.splice(index, 1);
      } else {
        state.answers.healthConditions.push(value);
      }
      saveProgress();
      updateNavigationButtons();
    };

    function validateCurrentQuestion(): boolean {
      const question = quizQuestions[state.currentQuestion];
      if (!question.required) return true;

      if (question.id === 'healthConditions') {
        return Array.isArray(state.answers.healthConditions) && state.answers.healthConditions.length > 0;
      }

      return state.answers[question.id as keyof QuizAnswers] !== undefined;
    }

    function updateNavigationButtons() {
      const prevBtn = document.getElementById('prev-btn');
      const nextBtn = document.getElementById('next-btn');
      const submitBtn = document.getElementById('submit-btn');

      if (prevBtn) prevBtn.disabled = state.currentQuestion === 0;
      
      const isValid = validateCurrentQuestion();
      const isLastQuestion = state.currentQuestion === quizQuestions.length - 1;

      if (isLastQuestion) {
        if (nextBtn) nextBtn.classList.add('hidden');
        if (submitBtn) {
          submitBtn.classList.remove('hidden');
          submitBtn.disabled = !isValid;
        }
      } else {
        if (nextBtn) {
          nextBtn.classList.remove('hidden');
          nextBtn.disabled = !isValid;
        }
        if (submitBtn) submitBtn.classList.add('hidden');
      }
    }

    function updateProgress() {
      const progress = ((state.currentQuestion + 1) / quizQuestions.length) * 100;
      const progressBar = document.getElementById('progress-bar');
      const progressText = document.getElementById('progress-text');
      const progressPercentage = document.getElementById('progress-percentage');
      
      if (progressBar) progressBar.style.width = `${progress}%`;
      if (progressText) progressText.textContent = `Question ${state.currentQuestion + 1} of ${quizQuestions.length}`;
      if (progressPercentage) progressPercentage.textContent = `${Math.round(progress)}%`;
    }

    function saveProgress() {
      localStorage.setItem('procedure-quiz-progress', JSON.stringify({
        currentQuestion: state.currentQuestion,
        answers: state.answers
      }));
    }

    function calculateAndShowResults() {
      // Calculate recommendations
      state.recommendations = calculateRecommendations(state.answers);
      
      // Clear saved progress
      localStorage.removeItem('procedure-quiz-progress');

      // Hide quiz form
      document.querySelector('.bg-white.rounded-2xl.shadow-2xl')?.classList.add('hidden');
      document.querySelector('.bg-gradient-to-br.from-blue-50')?.classList.add('hidden');

      // Show results
      displayResults();
    }

    function displayResults() {
      const resultsContainer = document.getElementById('results-container');
      const template = document.getElementById('results-template') as HTMLTemplateElement;
      
      if (!resultsContainer || !template) {
        console.error('Results container or template not found');
        return;
      }

      const primary = state.recommendations[0];
      const alternatives = state.recommendations.slice(1, 3); // Top 2 alternatives

      // Clone template
      const resultsClone = template.content.cloneNode(true) as DocumentFragment;

      // Populate primary recommendation
      const procedure = procedures.find(p => p.slug === primary.procedureSlug);
      
      // Set primary procedure name and match
      const primaryProcedureEl = resultsClone.querySelector('#primary-procedure');
      const matchPercentageEl = resultsClone.querySelector('#match-percentage');
      if (primaryProcedureEl) primaryProcedureEl.textContent = primary.procedure;
      if (matchPercentageEl) matchPercentageEl.textContent = `${primary.matchPercentage}% Match`;

      // Set reasons
      const reasonsEl = resultsClone.querySelector('#recommendation-reasons');
      if (reasonsEl) {
        reasonsEl.innerHTML = primary.reasons.map(reason => `
          <div class="flex items-start">
            <span class="text-blue-600 mr-2">•</span>
            <span class="text-gray-700">${reason}</span>
          </div>
        `).join('');
      }

      // Set pros
      const prosList = resultsClone.querySelector('#pros-list');
      if (prosList) {
        prosList.innerHTML = primary.pros.map(pro => `<li>${pro}</li>`).join('');
      }

      // Set cons
      const consList = resultsClone.querySelector('#cons-list');
      if (consList) {
        consList.innerHTML = primary.cons.map(con => `<li>${con}</li>`).join('');
      }

      // Set expected outcomes
      const weightLossEl = resultsClone.querySelector('#expected-weight-loss');
      const timelineEl = resultsClone.querySelector('#expected-timeline');
      const healthImprovementsEl = resultsClone.querySelector('#health-improvements');
      
      if (weightLossEl) weightLossEl.textContent = primary.expectedOutcomes.weightLoss;
      if (timelineEl) timelineEl.textContent = primary.expectedOutcomes.timeline;
      if (healthImprovementsEl) {
        healthImprovementsEl.innerHTML = primary.expectedOutcomes.healthImprovements
          .map(improvement => `<li>${improvement}</li>`).join('');
      }

      // Set cost
      const costRangeEl = resultsClone.querySelector('#cost-range');
      const costInsuranceEl = resultsClone.querySelector('#cost-insurance');
      if (costRangeEl) costRangeEl.textContent = `$${primary.costEstimate.min.toLocaleString()} - $${primary.costEstimate.max.toLocaleString()}`;
      if (costInsuranceEl) costInsuranceEl.textContent = primary.costEstimate.withInsurance;

      // Set recovery
      const recoveryEl = resultsClone.querySelector('#recovery-timeline');
      if (recoveryEl) recoveryEl.textContent = primary.recoveryTimeline;

      // Set next steps
      const nextStepsEl = resultsClone.querySelector('#next-steps');
      if (nextStepsEl) {
        nextStepsEl.innerHTML = primary.nextSteps.map(step => `<li>${step}</li>`).join('');
      }

      // Update find surgeons link
      const findSurgeonsBtn = resultsClone.querySelector('#find-surgeons-btn');
      if (findSurgeonsBtn && procedure) {
        (findSurgeonsBtn as HTMLAnchorElement).href = `/surgeons?procedure=${primary.procedureSlug}`;
      }

      // Set alternatives
      const alternativesEl = resultsClone.querySelector('#alternative-recommendations');
      if (alternativesEl && alternatives.length > 0) {
        alternativesEl.innerHTML = alternatives.map(alt => {
          const altProcedure = procedures.find(p => p.slug === alt.procedureSlug);
          return `
            <div class="bg-gray-50 rounded-xl p-6 border-2 border-gray-200">
              <div class="flex justify-between items-start mb-4">
                <div>
                  <h4 class="text-xl font-bold text-gray-900">${alt.procedure}</h4>
                  <p class="text-lg font-semibold text-blue-600">${alt.matchPercentage}% Match</p>
                </div>
                <a href="/procedures/${alt.procedureSlug}" class="text-blue-600 hover:text-blue-700 font-medium">
                  Learn More →
                </a>
              </div>
              <div class="space-y-2 text-gray-700">
                <p class="font-semibold">Why consider this:</p>
                <ul class="list-disc list-inside space-y-1">
                  ${alt.reasons.slice(0, 2).map(reason => `<li>${reason}</li>`).join('')}
                </ul>
                <p class="mt-3">
                  <span class="font-semibold">Expected weight loss:</span> ${alt.expectedOutcomes.weightLoss}
                </p>
              </div>
            </div>
          `;
        }).join('');
      }

      // Insert results
      resultsContainer.innerHTML = '';
      resultsContainer.appendChild(resultsClone);
      resultsContainer.classList.remove('hidden');

      // Scroll to results
      setTimeout(() => {
        resultsContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 100);

      // Generate shareable link
      generateShareableLink();
    }

    function generateShareableLink() {
      // Encode results in URL for sharing
      const encoded = btoa(JSON.stringify({
        primary: state.recommendations[0].procedureSlug,
        match: state.recommendations[0].matchPercentage,
        timestamp: Date.now()
      }));
      // Store in sessionStorage for share functionality
      sessionStorage.setItem('quiz-results', encoded);
      
      // Update URL with hash for shareable link
      const shareUrl = `${window.location.origin}${window.location.pathname}#results=${encoded}`;
      if (history.replaceState) {
        history.replaceState(null, '', shareUrl);
      }
    }

    // Check for shared results on page load
    window.addEventListener('DOMContentLoaded', () => {
      const hash = window.location.hash;
      if (hash && hash.startsWith('#results=')) {
        const encoded = hash.replace('#results=', '');
        try {
          const results = JSON.parse(atob(encoded));
          // Could restore results view here if needed
          console.log('Shared results detected:', results);
        } catch (e) {
          console.error('Error parsing shared results:', e);
        }
      }
    });
  </script>
</BaseLayout>

