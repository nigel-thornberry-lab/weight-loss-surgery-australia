        </div>

        <!-- Tier 2: Featured Interview -->
        <div class="bg-gradient-to-br from-green-50 to-green-100 border-2 border-green-500 rounded-lg p-8 relative">
          <div class="absolute top-0 right-0 bg-green-500 text-white px-4 py-1 text-sm font-semibold rounded-bl-lg rounded-tr-lg">
            HIGHLY RECOMMENDED
          </div>
          <div class="text-center mb-6 mt-4">
