            </li>
            <li class="flex items-start gap-2">
              <span class="text-green-600 text-xl">✓</span>
              <span class="text-gray-700"><strong>Newsletter feature</strong> - 5,000+ subscribers</span>
            </li>
          </ul>
          <div class="mt-6 text-center text-sm text-gray-600">
            Value: <strong>$12,000/year</strong> | Time: <strong>15 minutes</strong> | Cost: <strong class="text-green-600">FREE</strong>
          </div>
        </div>
      </div>

      <!-- Total Value Box -->
      <div class="max-w-3xl mx-auto bg-gradient-to-r from-purple-100 to-pink-100 border-2 border-purple-400 rounded-lg p-8 text-center">
        <h3 class="text-3xl font-bold text-gray-900 mb-4">📊 Total Value Stack</h3>
        <div class="grid md:grid-cols-3 gap-6 mb-6">
          <div>
            <div class="text-4xl font-bold text-purple-600">$25,600+</div>
            <div class="text-sm text-gray-600">Annual marketing value</div>
          </div>
          <div>
            <div class="text-4xl font-bold text-purple-600">30 min</div>
            <div class="text-sm text-gray-600">Total time investment</div>
          </div>
          <div>
            <div class="text-4xl font-bold text-green-600">$0</div>
            <div class="text-sm text-gray-600">What you pay</div>
