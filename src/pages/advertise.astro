        <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow">
          <div class="text-4xl mb-4">📍</div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Local Search Visibility</h3>
          <p class="text-gray-600">
            Get found when patients search for bariatric surgeons in your area. Your practice appears in our location-based search results.
          </p>
        </div>

        <!-- Benefit 3 -->
        <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow">
          <div class="text-4xl mb-4">✅</div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Verified Credentials Badge</h3>
          <p class="text-gray-600">
            We verify your AHPRA registration quarterly and display a "Verified" badge on your profile. Patients see you're actively registered and credentialed, updated every 90 days automatically.
          </p>
        </div>

        <!-- Benefit 4 -->
        <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow">
          <div class="text-4xl mb-4">📈</div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Increase Inbound Leads</h3>
          <p class="text-gray-600">
            Direct patient inquiries through phone and website links. Track exactly how many patients find you through the directory each month.
          </p>
        </div>

        <!-- Benefit 5 -->
        <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow">
          <div class="text-4xl mb-4">🌐</div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Boost Your Website Traffic</h3>
          <p class="text-gray-600">
            Direct link to your practice website with every listing. Turn directory visitors into website visitors and consultation bookings.
          </p>
        </div>

        <!-- Benefit 6 -->
        <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow">
          <div class="text-4xl mb-4">📱</div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Mobile-Optimized</h3>
          <p class="text-gray-600">
            Your listing looks perfect on every device and loads quickly. Patients can find you whether they're searching on phone, tablet, or desktop.
          </p>
        </div>

        <!-- Benefit 7 -->
        <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow">
          <div class="text-4xl mb-4">🎥</div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Add Video Introduction</h3>
          <p class="text-gray-600">
            Upload a 60-90 second video from your phone. Introduce yourself, show your clinic, explain your approach. The video appears at the top of your profile. Patients who watch videos are 3x more likely to book a consultation.
          </p>
        </div>

        <!-- Benefit 8 -->
        <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow">
          <div class="text-4xl mb-4">💬</div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Personality Interview Section</h3>
          <p class="text-gray-600">
            Answer questions like "What's your surgical philosophy?" and "How do you support patients long-term?" We provide 8 specific questions. You answer them once in your dashboard. They appear on your profile so patients understand your approach before booking.
          </p>
        </div>

        <!-- Benefit 9 -->
        <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow">
          <div class="text-4xl mb-4">📊</div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Profile Analytics Dashboard</h3>
          <p class="text-gray-600">
            Log in monthly to see: Total profile views, website clicks, phone number reveals, and video plays. Track which days get the most traffic. Export data to CSV for your records.
          </p>
        </div>

        <!-- Benefit 10 -->
        <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow">
          <div class="text-4xl mb-4">🔄</div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Easy Management</h3>
          <p class="text-gray-600">
            Update your profile, photos, and information anytime with our simple dashboard. No technical skills required.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- What You Get Section -->
  <section id="what-you-get" class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Everything You Get (100% Free)
        </h2>
        <p class="text-xl text-gray-600">
          No credit card required. No hidden fees. Just pure value for verified bariatric surgeons.
        </p>
      </div>

      <!-- Value Stack Grid -->
      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto mb-12">
        <!-- Tier 1: Basic (Everyone Gets This) -->
        <div class="bg-gradient-to-br from-blue-50 to-blue-100 border-2 border-blue-300 rounded-lg p-8">
          <div class="text-center mb-6">
            <h3 class="text-2xl font-bold text-gray-900 mb-2">✅ Verified Profile</h3>
            <p class="text-gray-700">Every surgeon gets this automatically</p>
          </div>
          <ul class="space-y-3">
            <li class="flex items-start gap-2">
              <span class="text-blue-600 text-xl">✓</span>
              <span class="text-gray-700"><strong>AHPRA verification badge</strong> - Updated quarterly</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-blue-600 text-xl">✓</span>
              <span class="text-gray-700"><strong>Full profile page</strong> - Credentials, hospitals, contact info</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-blue-600 text-xl">✓</span>
              <span class="text-gray-700"><strong>Patient inquiries</strong> - Direct phone/website links</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-blue-600 text-xl">✓</span>
              <span class="text-gray-700"><strong>Analytics dashboard</strong> - Track profile views monthly</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-blue-600 text-xl">✓</span>
              <span class="text-gray-700"><strong>Embeddable badge</strong> - Link from your website to us</span>
