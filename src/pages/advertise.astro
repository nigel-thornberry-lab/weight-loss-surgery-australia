        <div class="flex items-start gap-4">
          <div class="text-5xl">🔗</div>
          <div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3">Boost Your SEO With Our Badge</h3>
            <p class="text-gray-700 mb-4">
