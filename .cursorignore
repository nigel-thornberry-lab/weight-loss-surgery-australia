# .cursorignore
# Exclude historical documentation and implementation summaries from AI indexing
# This improves AI output quality by reducing noise in semantic search

# ============================================================================
# Implementation Summaries & Completion Reports
# ============================================================================
*-COMPLETE.md
*-SUMMARY.md
*-FIXES-COMPLETE.md
*-CHANGES-COMPLETE.md
*-IMPLEMENTATION-COMPLETE.md
*-DEPLOYMENT-COMPLETE.md
*-SETUP-COMPLETE.md
*-OPTIMIZATION-COMPLETE.md
*-ENHANCEMENT-COMPLETE.md
*-PHASE-*-COMPLETE.md
*-BATCH-*-COMPLETE.md

# ============================================================================
# Audit Reports & Reviews
# ============================================================================
*-AUDIT.md
*-REVIEW.md
*-REVIEWS.md
*-ANALYSIS.md
*-REPORT.md
*-CORRECTIONS.md
*-FIXES-APPLIED.md
*-VERIFICATION.md

# ============================================================================
# Historical Email Sequence Documentation
# ============================================================================
EMAIL-SEQUENCE-*.md
REVISED-EMAIL-*.md
COMPLETE-EMAIL-*.md
drip-mcp-server/email-sequences/*.md
!EMAIL-0[1-7]-*.md
!EMAIL-*-TEMPLATE.md

# ============================================================================
# Batch Processing & Status Files
# ============================================================================
BATCH-*.md
*-STATUS.md
*-PROGRESS.md
*-QUEUE.md

# ============================================================================
# Research Data & Historical Analysis
# ============================================================================
*-RESEARCH.md
*-DATA.md
*-INSIGHTS.md
*-OPPORTUNITIES-*.md
*-REANALYSIS.md

# ============================================================================
# One-Time Setup & Deployment Docs
